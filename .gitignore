# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc & OS
.DS_Store
*.pem
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# debug & logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel & turbopack
.vercel
.turbo

# IDE & editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# typescript
*.tsbuildinfo
next-env.d.ts

# sqlite local database
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# local uploads & generated caches
/uploads/
/data/*.json
/data/processed/*
!/data/processed/.gitkeep
/data/profile/*
!/data/profile/.gitkeep
/data/corpus/*
!/data/corpus/.gitkeep

